<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="note_icon">@color/light_txt</color>
    <color name="note_danger">@color/light_acc</color>
    <style name="NoteTitle" parent="@android:style/TextAppearance.Material.Notification.Title">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:maxLines">1</item>
    </style>
    <style name="NoteTime" parent="@android:style/TextAppearance.Material.Notification.Info">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>
    <style name="NoteButton">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:padding">12dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
        <item name="android:tint">@color/note_icon</item>
    </style>
</resources>
